{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "global-mcp-search",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-02",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"redact_query_string": false,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true,
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1,
		},
	},
	"routes": [
		{
			"pattern": "shopify-global-search.facetimefy.com",
			"zone_name": "facetimefy.com",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false,
		},
	],
	"workers_dev": false,
	"preview_urls": false,
	"vars": {
		"SHOPIFY_CATALOG_ID": "01m162j10csep1p5vz4tnkegch",
	},
}
